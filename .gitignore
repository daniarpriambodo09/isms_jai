__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store
# Database backups (contain password hashes and SMTP settings)
backup*.sql
*.sql.gz
*.dump
*.bak

# Uploaded files (confidential documents, photos, medical letters) — they
# live on the server's disk only, never in git. Folders are created at runtime.
storage/

# TypeScript incremental build cache (rewritten by every build)
*.tsbuildinfo

# Local backups (npm run backup) — database dumps and copies of storage/
backups/
